{
    auto_https off
}

http://yourdomain.domain.com {
    redir https://yourdomain.domain.com{uri} 301
}

https://yourdomain.domain.com {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	log {
		output file /var/log/caddy/access.log {
			roll_keep_for 24h
		}

		format filter {
			wrap json
			level delete
			logger delete
			msg delete
			request delete
			bytes_read delete
			user_id delete
			duration delete
			size delete
			status delete
			resp_headers delete
		}
    }

    # Assets for the maintenance page, served by Caddy so they work while the app is down
    handle_path /_huolto/* {
        root * /srv/errors
        file_server
    }

    handle {
        reverse_proxy web:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Also show the maintenance page when the app itself answers with a 5xx
            @upstream_error status 5xx
            handle_response @upstream_error {
                error "upstream error" 502
            }
        }
    }

    # App unreachable / timed out -> maintenance page (keeps the error status, so htmx won't swap it in)
    handle_errors 502 503 504 {
        root * /srv/errors
        rewrite * /maintenance.html
        header Cache-Control "no-store"
        file_server
    }
}