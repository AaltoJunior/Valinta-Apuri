ENV = "production"
CLIENT_ID = "client-id-from-azure"
TENANT_ID = "tenant-id-from-azure"
LIST_ID = "apuri-data-list-id"
LINKS_LIST_ID = "apuri-links-list-id"
SITE_HOST = "tenant.sharepoint.com"
SITE_PATH = "/sites/site-name"
# Paths inside the bg container; ./secrets is mounted at /secrets
CERT_FILE = "/secrets/apuri.crt"
KEY_FILE = "/secrets/apuri.key"
